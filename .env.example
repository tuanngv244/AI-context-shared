# Replace all password/token placeholders; use URL-safe values.
NODE_ENV=production
POSTGRES_PASSWORD=replace-with-strong-password
DATABASE_URL=postgresql://sce:replace-with-strong-password@postgres:5432/sce
SCE_RUNTIME_PASSWORD=replace-with-another-strong-password
API_DATABASE_URL=postgresql://sce_runtime:replace-with-another-strong-password@postgres:5432/sce
SCE_WORKER_PASSWORD=replace-with-a-worker-password
WORKER_DATABASE_URL=postgresql://sce_worker:replace-with-a-worker-password@postgres:5432/sce
REDIS_PASSWORD=replace-with-redis-password
REDIS_URL=redis://:replace-with-redis-password@redis:6379
API_PORT=8787
AUTH_MODE=local
SCE_LOCAL_TOKEN=replace-with-at-least-32-random-characters
SCE_LOCAL_ORG_ID=11111111-1111-4111-8111-111111111111
SCE_SEED_DEMO=true
SCE_ALLOWED_ORIGIN=http://localhost:3000
# For remote teams set AUTH_MODE=oidc and SCE_SEED_DEMO=false:
AUTH_ISSUER_URL=
AUTH_JWKS_URL=
AUTH_AUDIENCE=sce
EMBEDDING_PROVIDER=disabled
EXTRACTION_PROVIDER=disabled
